# Salin menjadi .env lalu isi. JANGAN commit file .env ke GitHub.
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

PORT=3001
# Asal frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# Kata sandi awal bila impor CSV tidak menyertakan kolom password
DEFAULT_IMPORT_PASSWORD=

# Asisten AI (Fase 2) — endpoint kompatibel OpenAI
AI_BASE_URL=https://ai.sumopod.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
